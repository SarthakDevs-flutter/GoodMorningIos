# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # The Flutter alarm package ships a bundled default.m4a fallback. iOS 26+
    # uses AlarmKit and our bundled tones for audible alarms, so keep that fallback
    # out of the app bundle to prevent old package schedules from playing it.
    if target.name == 'alarm-alarm'
      target.resources_build_phase.files.each do |build_file|
        file_ref = build_file.file_ref
        next unless file_ref&.path&.end_with?('default.m4a')

        target.resources_build_phase.remove_build_file(build_file)
      end
    end

    # Local Weather only needs while-in-use location. Keep the geolocator iOS
    # pod from compiling Always-location permission code.
    if target.name == 'geolocator_apple'
      target.build_configurations.each do |config|
        definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        definitions = ['$(inherited)'] if definitions.nil?
        definitions = [definitions] if definitions.is_a?(String)
        definitions << 'BYPASS_PERMISSION_LOCATION_ALWAYS=1'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions.uniq
      end
    end
  end

  # com.apple.provenance / FinderInfo break codesign on copied frameworks (QA1940).
  sandbox_root = installer.sandbox.root
  if sandbox_root && File.directory?(sandbox_root)
    system('xattr', '-cr', sandbox_root.to_s)
  end

  project_root = File.expand_path('..', __dir__)
  build_dir = File.join(project_root, 'build')
  if File.directory?(build_dir)
    system('xattr', '-cr', build_dir)
  end
end
